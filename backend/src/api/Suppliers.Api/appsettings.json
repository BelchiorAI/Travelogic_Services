{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowLocalhost": false
  },
  "Media": {
    "S3": {
      "BucketName": "supplier-media",
      "Region": "us-east-1",
      "ServiceUrl": "",
      "PublicServiceUrl": "",
      "CreateBucketIfMissing": false
    }
  },
  "Ai": {
    "Enabled": false,
    "Model": "",
    "ApiKey": "",
    "Endpoint": "",
    "TimeoutSeconds": 30
  }
}
