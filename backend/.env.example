# Copy to .env (git-ignored) and fill in to enable AI extraction in docker compose.

# SQL Server sa password (optional; the default is a throwaway local-dev password).
# MSSQL_SA_PASSWORD=

AI_ENABLED=true
AI_MODEL=<model name from your provider>
AI_API_KEY=<your API key>

# Leave empty for OpenAI. For Gemini's OpenAI-compatible API:
# AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/
AI_ENDPOINT=
